{
    "schemaVersion": 1,
    "id": "mcbraziers",
    "version": "${version}",
    "name": "MC Braziers",
    "description": "Vanilla+ braziers: campfires held in cages of bars. Six tiers from copper to netherite, four fire types, floor, wall and hanging placement, connected fire pits, cooking, and copper that ages.",
    "authors": [
        "dai"
    ],
    "contact": {
        "homepage": "https://github.com/DalL337/mcbraziers",
        "sources": "https://github.com/DalL337/mcbraziers",
        "issues": "https://github.com/DalL337/mcbraziers/issues"
    },
    "license": "MIT",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.dai.mcbraziers.McBraziers"
        ],
        "client": [
            "com.dai.mcbraziers.client.McBraziersClient"
        ],
        "fabric-datagen": [
            "com.dai.mcbraziers.datagen.McBraziersDataGenerator"
        ]
    },
    "mixins": [
        "mcbraziers.mixins.json",
        {
            "config": "mcbraziers.client.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=0.19.5",
        "minecraft": "~26.3",
        "java": ">=25",
        "fabric-api": "*"
    }
}
